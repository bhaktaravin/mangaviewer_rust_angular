# MongoDB Configuration
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme_secure_password
DATABASE_NAME=mangaviewer

# Redis Configuration
REDIS_PASSWORD=changeme_redis_password

# JWT Secret (CHANGE THIS!)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# Server Configuration
SERVER_PORT=8080
RUST_LOG=info

# Frontend Configuration
FRONTEND_PORT=80
CORS_ORIGIN=http://localhost

# OpenAI API Key (Optional - for AI features)
OPENAI_API_KEY=

# Local Manga Storage Path (Optional - for local file import)
MANGA_STORAGE_PATH=./manga_storage

# Backup Configuration
BACKUP_PATH=./backups

# Backblaze B2 Storage Configuration (Optional - for manga image storage)
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_ACCESS_KEY_ID=your_b2_application_key_id
B2_SECRET_ACCESS_KEY=your_b2_application_key
B2_BUCKET_NAME=your-bucket-name
B2_PUBLIC_URL=https://f004.backblazeb2.com/file/your-bucket-name
